{
  "$schema": "../../../../pochita-webui-kit/packages/contracts-gen/contract.schema.json",
  "schemaVersion": 1,
  "name": "sideveil-theme-hud",
  "description": "Shared dynamic theme palette and native vector HUD wire contracts for SideVeil.",
  "enums": {
    "HudTextAlign": {
      "doc": "Horizontal text alignment for HWUI text overlays on native vector HUDs.",
      "renameAll": "camelCase",
      "variants": [{ "name": "Start" }, { "name": "Center" }, { "name": "End" }]
    }
  },
  "structs": {
    "HostDynamicColorsPayload": {
      "doc": "Dynamic Material You wallpaper seed reported by Render Host.",
      "renameAll": "camelCase",
      "rustDerives": ["Debug", "Clone", "Copy", "PartialEq", "Serialize", "Deserialize"],
      "fields": [
        { "name": "seed_argb", "type": "u32" },
        { "name": "luma_hint", "type": "f32", "default": 0.5 },
        { "name": "is_dark", "type": "bool" }
      ]
    },
    "GlassTintOverride": {
      "doc": "Native AGSL glass tint palette synthesized in perceptual Oklch space.",
      "renameAll": "camelCase",
      "rustDerives": ["Debug", "Clone", "Copy", "PartialEq", "Eq", "Serialize", "Deserialize"],
      "fields": [
        { "name": "tint_top_argb", "type": "u32" },
        { "name": "tint_bottom_argb", "type": "u32" },
        { "name": "rim_argb", "type": "u32" },
        { "name": "accent_argb", "type": "u32" },
        { "name": "fallback_fill_argb", "type": "u32" },
        { "name": "fallback_stroke_argb", "type": "u32" }
      ]
    },
    "DynamicThemePalette": {
      "doc": "Synthesized theme palette broadcast from Hub to Render Host and WebViews.",
      "renameAll": "camelCase",
      "fields": [
        { "name": "theme_id", "type": "string" },
        { "name": "is_dark", "type": "bool" },
        { "name": "seed_argb", "type": "u32" },
        { "name": "luma_hint", "type": "f32" },
        { "name": "glass", "type": { "ref": "GlassTintOverride" } },
        { "name": "css_tokens", "type": { "map": ["string", "string"] }, "default": {} }
      ]
    },
    "HudDismissPayload": {
      "doc": "Payload for dismissing an active native HUD overlay.",
      "renameAll": "camelCase",
      "rustDerives": ["Debug", "Clone", "PartialEq", "Eq", "Serialize", "Deserialize"],
      "fields": [
        {
          "name": "plugin_id",
          "type": "string",
          "optional": true,
          "skipSerializingIfNone": true
        }
      ]
    },
    "HudDismissResult": {
      "doc": "Acknowledgement returned by hud.dismiss.",
      "renameAll": "camelCase",
      "fields": [{ "name": "ok", "type": "bool" }]
    },
    "HudTextOverlay": {
      "doc": "Native HWUI text overlay item composited above vello_cpu vector HUD layers.",
      "renameAll": "camelCase",
      "fields": [
        { "name": "x", "type": "f32" },
        { "name": "y", "type": "f32" },
        { "name": "text", "type": "string" },
        { "name": "size_sp", "type": "f32", "optional": true, "default": 12.0 },
        { "name": "color_argb", "type": "u32", "optional": true, "default": 4294047225 },
        { "name": "align", "type": { "ref": "HudTextAlign" }, "optional": true },
        { "name": "bold", "type": "bool", "optional": true, "default": false },
        { "name": "tabular_nums", "type": "bool", "optional": true, "default": true },
        {
          "name": "max_width_dp",
          "type": "f32",
          "optional": true,
          "skipSerializingIfNone": true
        }
      ]
    }
  },
  "rpcs": {
    "HUD_DISMISS": {
      "method": "hud.dismiss",
      "params": { "ref": "HudDismissPayload" },
      "result": { "ref": "HudDismissResult" }
    }
  },
  "events": {
    "HOST_DYNAMIC_COLORS": {
      "event": "host.dynamicColors",
      "payload": { "ref": "HostDynamicColorsPayload" }
    },
    "THEME_PALETTE_UPDATED": {
      "event": "theme.paletteUpdated",
      "payload": { "ref": "DynamicThemePalette" }
    },
    "HUD_DISMISSED": {
      "event": "hud.dismissed",
      "payload": { "ref": "HudDismissPayload" }
    }
  },
  "outputs": [
    {
      "target": "rust",
      "path": "../hub/crates/sideveil-protocol/src/generated/theme_hud.rs",
      "header": "Source: contracts/theme-hud.contract.json",
      "include": {
        "enums": true,
        "structs": [
          "HostDynamicColorsPayload",
          "GlassTintOverride",
          "DynamicThemePalette",
          "HudDismissPayload"
        ]
      }
    },
    {
      "target": "kotlin",
      "path": "../android/protocol/src/main/kotlin/pochita/sideveil/protocol/generated/ThemeHudWire.kt",
      "package": "pochita.sideveil.protocol.generated",
      "header": "Source: contracts/theme-hud.contract.json",
      "include": {
        "enums": true,
        "structs": [
          "HostDynamicColorsPayload",
          "GlassTintOverride",
          "DynamicThemePalette",
          "HudDismissPayload"
        ]
      }
    },
    {
      "target": "ts",
      "path": "../../../../pochita-webui-kit/packages/sdk/src/generated/sideveilThemeHud.ts",
      "header": "Source: sideveil/contracts/theme-hud.contract.json",
      "methodsConstName": "SIDEVEIL_THEME_HUD_METHODS",
      "rpcMapName": "SideVeilThemeHudRpcMethodMap",
      "eventsConstName": "SIDEVEIL_THEME_HUD_EVENTS",
      "eventMapName": "SideVeilThemeHudEventPayloadMap",
      "include": { "enums": true, "structs": true, "rpcs": true, "events": true }
    },
    {
      "target": "jsonSchema",
      "path": "schemas/protocol-theme-hud.schema.json",
      "title": "SideVeil Theme Palette & Native HUD Schema",
      "include": { "enums": true, "structs": true }
    }
  ]
}
