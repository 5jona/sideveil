{
  "name": "sideveil-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.22.0",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import @pochita/config/register-ts --test test/*.test.mjs",
    "dev:control": "vite --config vite.control.config.mjs",
    "dev:panel": "vite --config vite.panel.config.mjs",
    "build:control": "vite build --config vite.control.config.mjs",
    "build:panel": "vite build --config vite.panel.config.mjs",
    "build": "pnpm build:control && pnpm build:panel",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "preview:control": "vite preview --config vite.control.config.mjs --port 4174",
    "preview:panel": "vite preview --config vite.panel.config.mjs --port 4175"
  },
  "dependencies": {
    "@pochita/bridge": "file:../../../../pochita-webui-kit/packages/bridge",
    "@pochita/config": "file:../../../../pochita-webui-kit/packages/config",
    "@pochita/sideveil-sdk": "file:../../../../pochita-webui-kit/packages/sdk",
    "@pochita/ui": "file:../../../../pochita-webui-kit/packages/ui",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
