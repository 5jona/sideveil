{
  "name": "sideveil-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.22.0",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import @gojona/config/register-ts --test test/*.test.mjs",
    "dev:control": "vite --config vite.control.config.mjs",
    "dev:panel": "vite --config vite.panel.config.mjs",
    "dev:vello-scope": "vite --config vite.vello-scope.config.mjs",
    "dev:native-perf-hud": "vite --config vite.native-perf-hud.config.mjs",
    "build:control": "vite build --config vite.control.config.mjs",
    "build:panel": "vite build --config vite.panel.config.mjs",
    "build:vello-scope": "vite build --config vite.vello-scope.config.mjs",
    "build:native-perf-hud": "vite build --config vite.native-perf-hud.config.mjs",
    "build:plugins": "pnpm build:vello-scope && pnpm build:native-perf-hud",
    "build": "pnpm build:control && pnpm build:panel && pnpm build:plugins",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "preview:control": "vite preview --config vite.control.config.mjs --port 4174",
    "preview:panel": "vite preview --config vite.panel.config.mjs --port 4175"
  },
  "dependencies": {
    "@gojona/bridge": "^0.1.0",
    "@gojona/config": "^0.1.0",
    "@gojona/sideveil-sdk": "^0.1.0",
    "@gojona/ui": "^0.1.0",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@gojona/contracts-gen": "^0.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
