#!/system/bin/sh
#
# CLI control utility for communicating with the running Sideveil UID 1000 daemon
# over its authenticated 127.0.0.1 HTTP/RPC endpoint.
#

set -eu

case "$0" in
    */*) SCRIPT_DIR="${0%/*}" ;;
    *)
        RESOLVED_SELF=$(command -v "$0" 2>/dev/null || printf '%s' "$0")
        case "$RESOLVED_SELF" in
            */*) SCRIPT_DIR="${RESOLVED_SELF%/*}" ;;
            *) SCRIPT_DIR="." ;;
        esac
        ;;
esac
. "${SCRIPT_DIR}/sideveil-common.sh"

json_escape() {
    printf '%s' "$1" | tr '\r\n\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

print_error() {
    ESCAPED_MSG=$(json_escape "$1")
    printf '{"error":"%s"}\n' "$ESCAPED_MSG" >&2
}

find_curl_bin() {
    for candidate in \
        "/system/bin/curl" \
        "$(command -v curl 2>/dev/null || true)" \
        "/data/adb/ksu/bin/curl" \
        "/data/adb/ap/bin/curl" \
        "/data/adb/magisk/curl"; do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    return 1
}

CURL_BIN=$(find_curl_bin || true)
if [ -z "$CURL_BIN" ]; then
    print_error "curl binary not found in /system/bin, PATH, or root manager bin directories"
    exit 127
fi

if ! load_daemon_env; then
    print_error "${SIDEVEIL_LAST_ERROR:-Failed to load daemon environment}"
    exit 1
fi

BASE_URL="http://127.0.0.1:${SIDEVEIL_PORT}"
AUTH_HEADER="Authorization: Bearer ${SIDEVEIL_TOKEN}"

call_get() {
    "$CURL_BIN" -fsS --max-time 3 -H "$AUTH_HEADER" "${BASE_URL}$1"
}

call_rpc() {
    "$CURL_BIN" -fsS --max-time 3 \
        -H "$AUTH_HEADER" \
        -H "Content-Type: application/json" \
        -d "{\"jsonrpc\":\"2.0\",\"id\":\"ctl\",\"method\":\"$1\"}" \
        "${BASE_URL}/rpc"
}

CMD="${1:-status}"
case "$CMD" in
    status)
        call_get "/status"
        ;;
    health)
        call_get "/health"
        ;;
    open)
        call_rpc "panel.open"
        ;;
    close)
        call_rpc "panel.close"
        ;;
    toggle)
        call_rpc "panel.toggle"
        ;;
    reload)
        call_rpc "config.reload"
        ;;
    restart-host)
        call_rpc "host.restart" >/dev/null 2>&1 || true
        sleep 1
        wake_host_service
        printf '{"jsonrpc":"2.0","id":"ctl","result":{"ok":true}}'
        ;;
    ping)
        call_rpc "daemon.ping"
        ;;
    logs)
        call_rpc "daemon.logs"
        ;;
    *)
        print_error "Unknown command: $CMD"
        exit 2
        ;;
esac
printf '\n'
