#!/system/bin/sh
#
# CLI control utility for communicating with the running Sideveil UID 1000 daemon
# over its authenticated 127.0.0.1 HTTP/RPC endpoint.
#

set -eu

RUN_ENV="/data/system/sideveil/run/daemon.env"
CURL_BIN="/system/bin/curl"

print_error() {
    printf '{"error":"%s"}\n' "$1" >&2
}

if [ ! -x "$CURL_BIN" ]; then
    print_error "curl binary not found at $CURL_BIN"
    exit 127
fi

if [ ! -r "$RUN_ENV" ]; then
    print_error "Daemon runtime state not found ($RUN_ENV)"
    exit 1
fi

# shellcheck disable=SC1090
. "$RUN_ENV"

if [ -z "${SIDEVEIL_PORT:-}" ] || [ -z "${SIDEVEIL_TOKEN:-}" ] || [ -z "${SIDEVEIL_PID:-}" ]; then
    print_error "Incomplete daemon environment in $RUN_ENV"
    exit 1
fi

if ! kill -0 "$SIDEVEIL_PID" 2>/dev/null; then
    print_error "Sideveil daemon pid $SIDEVEIL_PID is not alive"
    exit 1
fi

BASE_URL="http://127.0.0.1:${SIDEVEIL_PORT}"
AUTH_HEADER="Authorization: Bearer ${SIDEVEIL_TOKEN}"

call_get() {
    "$CURL_BIN" -fsS --max-time 3 -H "$AUTH_HEADER" "${BASE_URL}$1"
}

call_rpc() {
    "$CURL_BIN" -fsS --max-time 3 \
        -H "$AUTH_HEADER" \
        -H "Content-Type: application/json" \
        -d "{\"jsonrpc\":\"2.0\",\"id\":\"ctl\",\"method\":\"$1\"}" \
        "${BASE_URL}/rpc"
}

CMD="${1:-status}"
case "$CMD" in
    status)
        call_get "/status"
        ;;
    health)
        call_get "/health"
        ;;
    open)
        call_rpc "panel.open"
        ;;
    close)
        call_rpc "panel.close"
        ;;
    toggle)
        call_rpc "panel.toggle"
        ;;
    reload)
        call_rpc "config.reload"
        ;;
    restart-host)
        call_rpc "host.restart" >/dev/null 2>&1 || true
        sleep 1
        am start-foreground-service --user 0 \
            -n "pochita.sideveil.host/.HostService" \
            --ei port "$SIDEVEIL_PORT" \
            --es token "$SIDEVEIL_TOKEN" >/dev/null 2>&1 || true
        printf '{"jsonrpc":"2.0","id":"ctl","result":{"ok":true}}'
        ;;
    ping)
        call_rpc "daemon.ping"
        ;;
    logs)
        call_rpc "daemon.logs"
        ;;
    *)
        print_error "Unknown command: $CMD"
        exit 2
        ;;
esac
printf '\n'
