<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!--
        Scheme B RFC1918 private-net cleartext policy:
        Android's static network_security_config cannot express CIDR/RFC1918 ranges or local DNS
        suffixes (10/8, 172.16/12, 192.168/16, .lan, .local). PluginNetworkPolicy enforces a strict
        in-app triple-lock and blocks all public cleartext HTTP/WS traffic inside WebViewClient.
    -->
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
